DATABASE_URL=postgresql://postgres:change-me@localhost:5432/tasks
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=gemma4:e4b-it
LLM_ENABLED=true
LLM_STUB=0
